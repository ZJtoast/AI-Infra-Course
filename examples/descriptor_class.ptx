.version 9.5
.target sm_90a
.address_size 64
.visible .entry descriptor_class(
    .param .u64 tensor_map_ptr, .param .u64 result_ptr)
{
    .reg .b64 %map, %out;
    .reg .pred %large;
    .reg .b32 %flag;
    ld.param.u64 %map, [tensor_map_ptr];
    ld.param.u64 %out, [result_ptr];
    tensormap.query.alloc_class_large.global.b1024 %large, [%map];
    selp.u32 %flag, 1, 0, %large;
    st.global.u32 [%out], %flag;
    ret;
}
